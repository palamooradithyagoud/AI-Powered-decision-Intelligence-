    {
      "parameters": {
        "jsCode": "// Fan out to all three team members. Each gets the same project but their\n// own name + designation. Extend this list to add more recipients later.\nconst v = $('Validate Assignment').first().json;\n\nconst RECIPIENTS = [\n  { recipient: 'shivanallela363@gmail.com', name: 'Shiva Nallela', designation: 'UI/UX Designer' },\n  { recipient: 'charan1010107@gmail.com', name: 'Charan', designation: 'Backend Engineer' },\n  { recipient: 'palamooradithyagoud@gmail.com', name: 'Palamoor Adithya Goud', designation: 'Frontend Engineer' },\n];\n\nreturn RECIPIENTS.map((r) => ({\n  json: {\n    recipient: r.recipient,\n    name: r.name,\n    designation: r.designation,\n    project_name: v.project_name,\n    project_description: v.project_description,\n    assigned_by: v.assigned_by,\n    assignment_id: v.assignment_id,\n  },\n}));"
      },
      "id": "355af805-c34f-4a4d-b9b4-6b59ee118791",
      "name": "Build Recipients",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        384
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.recipient }}",
        "subject": "=Project Assignment: You have been assigned to {{ $json.project_name }}",
        "message": "=<div style=\"font-family: Arial, Helvetica, sans-serif; color: #1a1a1a; max-width: 600px; margin: 0 auto;\">\n  <h2 style=\"color: #2c3e50; border-bottom: 2px solid #2c3e50; padding-bottom: 8px;\">Project Assignment</h2>\n  <p>Hello <strong>{{ $json.name }}</strong>,</p>\n  <p>You have been assigned to the following project by the Project Lead.</p>\n  <table style=\"border-collapse: collapse; width: 100%; margin: 16px 0;\">\n    <tr><td style=\"padding: 8px 12px; background: #f4f6f8; font-weight: bold; width: 40%;\">Project</td><td style=\"padding: 8px 12px; border-bottom: 1px solid #eee;\">{{ $json.project_name }}</td></tr>\n    <tr><td style=\"padding: 8px 12px; background: #f4f6f8; font-weight: bold;\">Your Role / Designation</td><td style=\"padding: 8px 12px; border-bottom: 1px solid #eee;\">{{ $json.designation }}</td></tr>\n    <tr><td style=\"padding: 8px 12px; background: #f4f6f8; font-weight: bold;\">Assigned By</td><td style=\"padding: 8px 12px; border-bottom: 1px solid #eee;\">{{ $json.assigned_by }}</td></tr>\n  </table>\n  <p style=\"font-weight: bold; margin-bottom: 4px;\">Project Description:</p>\n  <p style=\"margin-top: 0; color: #444;\">{{ $json.project_description }}</p>\n  <p>Please review the project requirements and begin working on the tasks related to your assigned role. If you have any questions regarding the project or your responsibilities, please contact the Project Lead.</p>\n  <p style=\"margin-top: 24px;\">Best regards,<br/><strong>Project Lead</strong></p>\n</div>",
        "options": {
          "appendAttribution": false,
          "senderName": "Project Lead",
          "replyTo": "shivanallella@gmail.com"
        }
      },
