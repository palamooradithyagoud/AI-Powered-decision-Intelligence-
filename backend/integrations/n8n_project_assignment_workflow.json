    {
      "parameters": {
        "jsCode": "// Normalize + validate incoming assignment payload\nconst body = ($input.first().json.body) || $input.first().json || {};\n\nconst clean = (v) => (v === undefined || v === null ? '' : String(v).trim());\n\nconst project_name = clean(body.project_name);\nconst project_description = clean(body.project_description);\nconst assigned_by = clean(body.assigned_by) || 'Project Lead';\n\n// Duplicate protection key. If none supplied, generate a per-run key so\n// distinct runs are never falsely deduped against each other.\nconst assignment_id = clean(body.assignment_id) || ('auto-' + $execution.id);\nconst has_dedup_id = clean(body.assignment_id) !== '';\n\n// Validation: at minimum a project name is required\nlet is_valid = true;\nlet error_message = '';\nif (!project_name) {\n  is_valid = false;\n  error_message = 'Missing required field: project_name';\n}\n\nreturn [{\n  json: {\n    is_valid,\n    error_message,\n    assignment_id,\n    has_dedup_id,\n    project_name,\n    project_description,\n    assigned_by,\n  },\n}];"
      },
      "id": "21078280-b6d3-40af-85fd-4be3bd26ed1c",
      "name": "Validate Assignment",
      "type": "n8n-nodes-base.code",
